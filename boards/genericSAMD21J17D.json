{
  "build": {
    "cpu": "cortex-m0plus",
    "f_cpu": "1000000L",
    "mcu": "samd21j17d",
    "extra_flags": "-D__SAMD21J17D__"
  },
  "debug": {
    "jlink_device": "ATSAMD21J17D",
    "openocd_chipname": "at91samd21j17d",
    "openocd_target": "at91samdXX",
    "svd_path": "ATSAMD21J17D.svd"
  },
  "frameworks": {
