{
  "build": {
    "cpu": "cortex-m0plus",
    "f_cpu": "1000000L",
    "mcu": "samd10c13a",
    "extra_flags": "-D__SAMD10C13A__ -D__SAMD10__"
  },
  "debug": {
    "jlink_device": "ATSAMD10C13A",
    "openocd_chipname": "at91samd10c13a",
    "openocd_target": "at91samdXX",
    "svd_path": "ATSAMD10C13A.svd"
  },
  "frameworks": {
    "cmsis": {
      "package": "framework-cmsis-atmelsam",
      "script": "builder/frameworks/cmsis.py",
      "description": "CMSIS bare metal",
      "homepage": "",
      "title": "Atmel/Microchip CMSIS framework for SAM MCUs"
    }
  },
  "name": "SAMD10C13A (4k RAM, 8k FLASH)",
  "upload": {
    "maximum_ram_size": 4096,
    "maximum_size": 8192,
    "protocol": "cmsis-dap",
    "protocols": [
      "cmsis-dap",
      "blackmagic",
      "jlink",
      "stlink",
      "atmel-ice"
    ]
  },
  "url": "https://www.microchip.com/en-us/product/atsamd10c13a",
  "vendor": "Atmel/Microchip"
}
