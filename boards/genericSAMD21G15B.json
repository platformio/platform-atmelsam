      "title": "Atmel/Microchip CMSIS framework for SAM MCUs"
    }
  },
  "name": "SAMD21G15B (4k RAM, 32k FLASH)",
  "upload": {
    "maximum_ram_size": 4096,
    "maximum_size": 32768,
    "protocol": "cmsis-dap",
    "protocols": [
      "cmsis-dap",
      "blackmagic",
      "jlink",
      "atmel-ice"
