{
  "build": {
    "cpu": "cortex-m0plus",
    "f_cpu": "1000000L",
    "mcu": "samd21g15b",
    "extra_flags": "-D__SAMD21G15B__ -D__SAMD21__"
  },
  "debug": {
    "jlink_device": "ATSAMD21G15B",
    "openocd_chipname": "at91samd21g15b",
    "openocd_target": "at91samdXX",
    "svd_path": "ATSAMD21G15B.svd"
  },
  "frameworks": {
    "cmsis": {
      "package": "framework-cmsis-atmelsam",
